{
  "name": "h3_mime_i2v_action_demo",
  "scope": "PHYSICAL_4060_8GB_EXPLORATORY_NOT_5080_CERTIFICATION",
  "contract": {
    "engine": "minimax_h3",
    "mode": "i2v_mime",
    "width": 864,
    "height": 480,
    "frames": 90,
    "fps": 24.0,
    "duration_s": 3.75,
    "requires_audio": true
  },
  "prompt": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
    "4": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
    "5": {"class_type": "RandomNoise", "inputs": {"noise_seed": 42}},
    "6": {"class_type": "BasicGuider", "inputs": {"model": ["1", 0], "conditioning": ["7", 0]}},
    "11": {"class_type": "LoadImage", "inputs": {"image": "scene_still.png"}},
    "7": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": ["2", 0],
        "vae": ["3", 0],
        "prompt": "An unfolding alarm story in the same busy nuclear-energy control room, not a still portrait. In one continuous 3.75-second shot, an amber reactor warning lamp begins strobing. The nearer operator springs from the chair, leans across the console, throws a large guarded switch, and keeps working the controls. At the same time, the other operator swivels sharply toward the flashing central monitor, points to it, then reaches for a second control panel. A bright reactor-status waveform races across the monitor and indicator lights cascade across the room; both people stay visibly active from the first frame through the end. The camera makes a smooth urgent forward tracking move past the console so the reaction and the bustling room are clear. No cut. Generate only synchronized alarm beeps, relay clacks, an electrical surge, ventilation, and room hum. No dialogue, speech, voices, vocals, humming, or music.",
        "width": 864,
        "height": 480,
        "length": 90,
        "first_frame": ["11", 0]
      }
    },
    "8": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["5", 0], "guider": ["6", 0], "sampler": ["13", 0], "sigmas": ["14", 0], "latent_image": ["7", 1]}},
    "13": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
    "14": {"class_type": "BasicScheduler", "inputs": {"model": ["1", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0}},
    "9": {"class_type": "VAEDecode", "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
    "10": {"class_type": "CreateVideo", "inputs": {"images": ["9", 0], "fps": 24.0, "audio": ["15", 0]}},
    "12": {"class_type": "SaveVideo", "inputs": {"video": ["10", 0], "filename_prefix": "h3_mime_i2v_out", "format": "auto", "codec": "auto"}},
    "15": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["8", 0], "vae": ["4", 0]}}
  },
  "workflow": {"nodes": [], "links": []}
}
