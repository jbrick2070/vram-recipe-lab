{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRAM recipe lab campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "purpose",
    "independent_variable",
    "profiles",
    "cells"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "status": {"enum": ["STATIC_ONLY", "BLOCKED_PROFILE_ENROLLMENT"]},
    "purpose": {"type": "string", "minLength": 1},
    "independent_variable": {"type": "string", "minLength": 1},
    "block_reason": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recipe", "role", "phase", "profiles"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "recipe": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*\\.json$"},
          "role": {"enum": ["control", "candidate", "static"]},
          "phase": {"type": "string", "minLength": 1},
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
          }
        }
      }
    }
  }
}
