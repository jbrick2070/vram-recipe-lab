{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRAM recipe lab enrolled bench profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "purpose",
    "python",
    "comfyui",
    "custom_nodes",
    "model_paths_config",
    "model_manifest",
    "boot",
    "environment",
    "floor_runner"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "status": {"const": "ENROLLED_STATIC_ONLY"},
    "purpose": {"type": "string", "minLength": 1},
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "comfyui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "version", "git_commit", "main_py_sha256", "clean"],
      "properties": {
        "root": {"type": "string", "minLength": 3},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "git_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "main_py_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clean": {"const": true}
      }
    },
    "custom_nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "git_commit", "version", "init_py_sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "path": {"type": "string", "minLength": 3},
          "git_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
          "version": {"type": "string", "minLength": 1},
          "init_py_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "model_paths_config": {"$ref": "#/$defs/hashed_file"},
    "model_manifest": {"$ref": "#/$defs/hashed_file"},
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "fixed_argv", "forbidden_args", "sage_free"],
      "properties": {
        "port": {"const": "8199"},
        "fixed_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forbidden_args": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sage_free": {"const": true}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PYTHONUTF8", "PYTHONIOENCODING", "HF_HOME"],
      "properties": {
        "PYTHONUTF8": {"const": "1"},
        "PYTHONIOENCODING": {"const": "utf-8"},
        "HF_HOME": {"type": "string", "minLength": 3}
      }
    },
    "floor_runner": {"$ref": "#/$defs/hashed_file"}
  },
  "$defs": {
    "hashed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
